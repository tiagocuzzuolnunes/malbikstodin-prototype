        "description": "How to secure the scene, report the incident, and close the case.",
        "steps": {
          "secure": {
            "title": "Secure the scene",
            "description": "Stop work nearby, protect people, and stabilize any immediate hazards."
          },
          "report": {
            "title": "Record the incident",
            "description": "Capture what happened, when, where, and who was involved."
          },
          "notify": {
            "title": "Notify supervisors",
            "description": "Alert the responsible manager and safety contact without delay."
          },
          "investigate": {
            "title": "Investigate causes",
            "description": "Review evidence, interview witnesses, and identify contributing factors."
          },
          "close": {
            "title": "Close with actions",
            "description": "Document corrective actions and confirm the case is closed."
          }
        }
      },
      "projectQualityControl": {
        "title": "Project quality control",
        "description": "Checks that keep paving and production work within quality standards.",
        "steps": {
          "plan": {
            "title": "Define checkpoints",
            "description": "Set inspection points and acceptance criteria for the current work package."
          },
          "inspect": {
            "title": "Run field inspection",
            "description": "Measure and review materials, thickness, finish, and workmanship on site."
          },
          "document": {
            "title": "Document findings",
            "description": "Log results, photos, and any nonconformities in the project record."
          },
          "approve": {
            "title": "Approve or rework",
            "description": "Sign off accepted work or assign corrective actions before the next stage."
          }
        }
      },
      "deviceSecurityCheck": {
        "title": "Device security check",
        "description": "A short checklist to keep company devices compliant and secure.",
        "steps": {
          "inventory": {
            "title": "Confirm device inventory",
            "description": "Verify the assigned laptop, phone, or tablet is listed and active."
          },
          "verify": {
            "title": "Verify security controls",
            "description": "Check updates, encryption, screen lock, and approved software status."
          },
          "remediate": {
            "title": "Fix and confirm",
            "description": "Resolve gaps with IT support and mark the security check complete."
          }
        }
      }
    }
  },
